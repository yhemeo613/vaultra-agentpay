# ---- 部署账户 ----
# 只放一个专用测试钱包，不要用主钱包。.env 已在 .gitignore 里。
PRIVATE_KEY=
# 部署时可选覆盖：财库与仲裁人（生产必须是多签，不要用部署者本人）
# TREASURY_ADDRESS=
# ARBITER_ADDRESS=

# ---- RPC（可留空，用硬编码的公共节点）----
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# ---- BscScan 合约验证（https://bscscan.com/myapikey）----
BSCSCAN_API_KEY=

# ---- 服务注册（scripts/register-service.js）----
SERVICE_ID=infer-v1
AGENT_PRICE=1
AGENT_ENDPOINT=http://127.0.0.1:4021/v1/infer

# ---- 402 网关（demo/server.js）----
PORT=4021
RPC_URL=http://127.0.0.1:8545
ENDPOINT=http://127.0.0.1:4021/v1/infer

# 状态存储：memory | sqlite | redis
STORE=sqlite
STORE_FILE=agentpay.db
# REDIS_URL=redis://127.0.0.1:6379

# challenge 有效期（秒）
CHALLENGE_TTL_SECONDS=120

# 结算：服务方钱包私钥（交付成功后自动 claim）。不配则付款方超时可自行 refund。
PROVIDER_PRIVATE_KEY=

# ---- 推理（OpenAI 兼容接口；不配则用 mock）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=25000

# ---- TLS / mTLS ----
# REQUIRE_TLS=1
# TLS_REQUIRE_CLIENT_CERT=1
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
TLS_CA=certs/server.crt

# 有前置代理时（如 nginx 终结 TLS）：
# TRUST_PROXY=1
